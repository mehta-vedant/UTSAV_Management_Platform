generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String               @id @default(cuid())
  email       String               @unique
  phone       String?              @unique
  name        String?
  image       String?
  password    String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships OrganizationMember[]
}

model Organization {
  id                      String                   @id @default(cuid())
  name                    String
  slug                    String                   @unique
  description             String?
  startDate               DateTime
  endDate                 DateTime?
  budgetTarget            Decimal?                 @db.Decimal(12, 2)
  openingBalance          Decimal?                 @db.Decimal(12, 2)
  publicFundraisingTarget Decimal?                 @db.Decimal(12, 2)
  internalBudgetLimit     Decimal?                 @db.Decimal(12, 2)
  status                  OrganizationStatus       @default(ACTIVE)
  prasadMorningStart      String                   @default("08:00")
  prasadMorningEnd        String                   @default("11:00")
  prasadEveningStart      String                   @default("17:00")
  prasadEveningEnd        String                   @default("20:00")
  timezone                String                   @default("Asia/Kolkata")
  type                    OrganizationType         @default(FESTIVAL)
  featureFlags            Json?
  endedAt                 DateTime?
  endedById               String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  auditLogs               AuditLog[]
  bhogItems               BhogItem[]
  donations               Donation[]
  events                  Event[]
  expenses                Expense[]
  invitations             OrganizationInvitation[]
  members                 OrganizationMember[]
  volunteers              Volunteer[]
  tasks                   VolunteerTask[]

  @@index([slug])
}

model OrganizationMember {
  id               String                   @id @default(cuid())
  userId           String?
  email            String
  organizationId   String
  role             OrganizationRole
  isArchived       Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  donationsAdded   Donation[]
  eventAssignments EventAssignment[]
  expensesAdded    Expense[]                @relation("ExpenseAddedBy")
  expensesApproved Expense[]                @relation("ExpenseApprovedBy")
  invitationsSent  OrganizationInvitation[]
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTasks    VolunteerTask[]

  @@unique([userId, organizationId])
  @@unique([email, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Donation {
  id             String              @id @default(cuid())
  donorName      String
  amount         Decimal             @db.Decimal(12, 2)
  category       DonationCategory    @default(GENERAL)
  date           DateTime            @default(now())
  receivedAt     DateTime            @default(now())
  notes          String?
  isArchived     Boolean             @default(false)
  archivedAt     DateTime?
  archivedById   String?
  addedById      String?
  organizationId String
  eventId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  addedBy        OrganizationMember? @relation(fields: [addedById], references: [id])
  event          Event?              @relation(fields: [eventId], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([addedById])
  @@index([eventId])
}

model Expense {
  id             String              @id @default(cuid())
  title          String
  amount         Decimal             @db.Decimal(12, 2)
  category       ExpenseCategory     @default(MISCELLANEOUS)
  status         ExpenseStatus       @default(PENDING)
  notes          String?
  isArchived     Boolean             @default(false)
  addedById      String
  approvedById   String?
  requestedAt    DateTime            @default(now())
  approvedAt     DateTime?
  rejectedAt     DateTime?
  processedAt    DateTime?
  archivedAt     DateTime?
  archivedById   String?
  organizationId String
  eventId        String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  addedBy        OrganizationMember  @relation("ExpenseAddedBy", fields: [addedById], references: [id])
  approvedBy     OrganizationMember? @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  event          Event?              @relation(fields: [eventId], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventId])
  @@index([status])
}

model BhogItem {
  id             String       @id @default(cuid())
  name           String
  quantity       String
  status         BhogStatus   @default(PENDING)
  sponsorName    String?
  offeringDate   DateTime     @default(now())
  offeringWindow BhogOfferingWindow @default(MORNING)
  storage        String?
  estimatedCost  Decimal?     @db.Decimal(12, 2)
  notes          String?
  isArchived     Boolean      @default(false)
  organizationId String
  submittedAt    DateTime     @default(now())
  approvedAt      DateTime?
  preparedAt      DateTime?
  archivedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, offeringDate])
}

model Volunteer {
  id             String          @id @default(cuid())
  name           String
  phone          String?
  email          String?
  status         VolunteerStatus @default(PENDING)
  assignedTask   String?
  isArchived     Boolean         @default(false)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Event {
  id             String                   @id @default(cuid())
  organizationId String
  title          String
  description    String?
  startTime      DateTime
  endTime        DateTime
  location       String?
  budgetTarget   Decimal?                 @db.Decimal(12, 2)
  status         EventStatus              @default(PLANNED)
  isArchived     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments    EventAssignment[]
  registrations  EventRegistration[]
  expenses       Expense[]
  donations      Donation[]
  invitations    OrganizationInvitation[]
  tasks          VolunteerTask[]

  @@index([organizationId])
}

model VolunteerTask {
  id             String             @id @default(cuid())
  organizationId String
  eventId        String?
  title          String
  description    String?
  assignedToId   String
  status         TaskStatus         @default(PENDING)
  priority       TaskPriority       @default(MEDIUM)
  dueDate        DateTime?
  isArchived     Boolean            @default(false)
  completedAt     DateTime?
  archivedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignedTo     OrganizationMember @relation(fields: [assignedToId], references: [id], onDelete: Cascade)
  event          Event?             @relation(fields: [eventId], references: [id])
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventId])
  @@index([assignedToId])
}

model EventAssignment {
  id                   String             @id @default(cuid())
  eventId              String
  organizationMemberId String
  createdAt            DateTime           @default(now())
  event                Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member               OrganizationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, organizationMemberId])
  @@index([eventId])
  @@index([organizationMemberId])
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  phone     String?
  notes     String?
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model OrganizationInvitation {
  id             String              @id @default(cuid())
  organizationId String
  email          String
  role           OrganizationRole
  token          String              @unique
  expiresAt      DateTime
  accepted       Boolean             @default(false)
  eventId        String?
  invitedById    String?
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  event          Event?              @relation(fields: [eventId], references: [id])
  invitedBy      OrganizationMember? @relation(fields: [invitedById], references: [id])
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorMemberId  String?
  entityType     String
  entityId       String?
  action         String
  before         Json?
  after          Json?
  metadata       Json?
  visibility     AuditVisibility @default(INTERNAL)
  occurredAt      DateTime     @default(now())
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorMemberId])
  @@index([entityType, entityId])
}

enum OrganizationRole {
  ADMIN
  TREASURER
  COMMITTEE_MEMBER
  VOLUNTEER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DonationCategory {
  GENERAL
  BHOG
  DECORATION
  LIGHTING
  SPONSORSHIP
  OTHER
}

enum ExpenseCategory {
  IDOL
  DECORATION
  LIGHTING
  FOOD
  SOUND
  SECURITY
  EQUIPMENT
  MARKETING
  INFRASTRUCTURE
  TRAVEL
  RENTAL
  OPERATIONS
  MISCELLANEOUS
}

enum BhogStatus {
  PENDING
  PREPARED
}

enum BhogOfferingWindow {
  MORNING
  EVENING
}

enum VolunteerStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum OrganizationType {
  FESTIVAL
  CLUB
}

enum OrganizationStatus {
  ACTIVE
  ENDED
}

enum EventStatus {
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum AuditVisibility {
  INTERNAL
  PUBLIC
}
